{
  "identifier": "service",
  "title": "Service",
  "icon": "Service",
  "description": "A microservice in the catalog",
  "schema": {
    "properties": {
      "name": {
        "title": "Service Name",
        "type": "string",
        "description": "Unique identifier for the service (e.g., payment-service)"
      },
      "description": {
        "title": "Description",
        "type": "string",
        "description": "What this service does"
      },
      "language": {
        "title": "Language",
        "type": "string",
        "enum": ["Python", "Go", "Node.js", "Java", "Rust"],
        "description": "Primary programming language"
      },
      "owner": {
        "title": "Owner",
        "type": "string",
        "description": "Team or person responsible (e.g., platform-team)"
      },
      "repository_url": {
        "title": "Repository URL",
        "type": "string",
        "format": "url",
        "description": "GitHub repository URL"
      },
      "port": {
        "title": "Service Port",
        "type": "number",
        "description": "Port number the service runs on"
      },
      "health_check_url": {
        "title": "Health Check Endpoint",
        "type": "string",
        "description": "API endpoint for health checks (e.g., /health)"
      },
      "dependencies": {
        "title": "Dependencies",
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of services this depends on"
      },
      "tech_stack": {
        "title": "Tech Stack",
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Technologies and frameworks used"
      },
      "status": {
        "title": "Status",
        "type": "string",
        "enum": ["active", "deprecated", "experimental"],
        "enumColors": {
          "active": "green",
          "deprecated": "red",
          "experimental": "yellow"
        },
        "description": "Current status of the service"
      },
      "created_at": {
        "title": "Created At",
        "type": "string",
        "format": "date-time",
        "description": "When the service was created"
      },
      "path": {
        "title": "Monorepo Path",
        "type": "string",
        "description": "Path inside the monorepo (e.g., services/payment-service)"
      },
      "github_repository_id": {
        "title": "GitHub Repository ID",
        "type": "string",
        "description": "GitHub repository name used to relate PRs and workflow runs"
      },
      "serviceTier": {
        "title": "Service Tier",
        "type": "string",
        "enum": ["Tier 1", "Tier 2", "Tier 3"],
        "enumColors": {
          "Tier 1": "red",
          "Tier 2": "orange",
          "Tier 3": "green"
        },
        "description": "Criticality tier. Tier 1 requires human-only implementation."
      }
    },
    "required": [
      "name",
      "language",
      "owner",
      "repository_url"
    ]
  },
  "ownership": {
    "type": "Direct",
    "title": "Owning Teams"
  },
  "relations": {
    "managed_by_agents": {
      "title": "Managed By Agents",
      "description": "AI agents that manage this service",
      "target": "aiAgent",
      "required": false,
      "many": true
    }
  }
}

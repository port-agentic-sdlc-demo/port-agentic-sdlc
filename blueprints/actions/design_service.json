{
  "identifier": "design_service",
  "title": "Design Service",
  "icon": "Blueprint",
  "description": "Use AI to design a new service architecture based on existing services",
  "trigger": {
    "operation": "DAY-2",
    "type": "self-service",
    "blueprintIdentifier": "service",
    "userInputs": {
      "properties": {
        "feature_name": {
          "type": "string",
          "title": "Service Name",
          "description": "Name of the service to design (e.g., User Profile Service)"
        },
        "requirements": {
          "type": "string",
          "title": "Requirements",
          "description": "Describe what the service should do and any constraints"
        }
      },
      "required": ["feature_name", "requirements"]
    }
  },
  "invocationMethod": {
    "type": "WEBHOOK",
    "url": "https://removal-letter-cubicle.ngrok-free.dev/webhook/action",
    "requestBody": {
      "action_run_id": "{{ run.id }}",
      "action_id": "{{ action.identifier }}",
      "blueprint": "{{ entity.blueprint }}",
      "entity_id": "{{ entity.identifier }}",
      "trigger": "{{ trigger.type }}",
      "input_data": "{{ action.input }}"
    }
  },
  "publish": true
}

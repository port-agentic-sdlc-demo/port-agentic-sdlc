{
  "identifier": "implement_feature",
  "title": "Implement Feature",
  "icon": "Code",
  "description": "Use AI to implement a feature following approved architecture",
  "trigger": {
    "operation": "DAY-2",
    "type": "self-service",
    "blueprintIdentifier": "service",
    "userInputs": {
      "properties": {
        "jira_ticket": {
          "type": "string",
          "title": "Jira Ticket",
          "description": "Ticket ID and description (e.g., ONBOARD-42: Implement User Profile Service)"
        },
        "architecture": {
          "type": "string",
          "title": "Approved Architecture",
          "description": "The architecture design approved by the team"
        }
      },
      "required": ["jira_ticket", "architecture"]
    }
  },
  "invocationMethod": {
    "type": "WEBHOOK",
    "url": "https://removal-letter-cubicle.ngrok-free.dev/webhook/action",
    "method": "POST",
    "body": {
      "action_run_id": "{{ run.id }}",
      "action_id": "{{ action.identifier }}",
      "blueprint": "{{ entity.blueprint }}",
      "entity_id": "{{ entity.identifier }}",
      "trigger": "{{ trigger.type }}",
      "input_data": "{{ action.input }}"
    }
  },
  "publish": true
}

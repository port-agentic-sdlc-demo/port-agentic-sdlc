{
  "identifier": "review_code",
  "title": "Review Code",
  "icon": "CheckCircle",
  "description": "Use AI to review pull requests for security, quality, and performance",
  "trigger": {
    "operation": "DAY-2",
    "type": "self-service",
    "blueprintIdentifier": "service",
    "userInputs": {
      "properties": {
        "pr_url": {
          "type": "string",
          "title": "Pull Request URL",
          "description": "Full GitHub PR URL (e.g., https://github.com/org/repo/pull/123)"
        }
      },
      "required": ["pr_url"]
    }
  },
  "invocationMethod": {
    "type": "WEBHOOK",
    "url": "https://removal-letter-cubicle.ngrok-free.dev/webhook/action?action_run_id={{ run.id }}&action_id={{ action.identifier }}&blueprint={{ entity.blueprint }}&entity_id={{ entity.identifier }}&trigger={{ trigger.type }}",
    "synchronized": true
  },
  "publish": true
}

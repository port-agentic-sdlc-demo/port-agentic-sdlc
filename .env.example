# Anthropic API Configuration
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# Port Configuration (Direct API)
# BASE_URL: usually https://api.us.getport.io (for US instance)
# TOKEN: Get from Port instance settings
PORT_BASE_URL=
PORT_API_TOKEN=

# Port MCP Configuration
# For Machine-to-Machine authentication with Port's MCP Server
# CLIENT_ID and CLIENT_SECRET: Create from Port UI (Settings → API Tokens)
# MCP_URL: https://mcp.us.port.io/v1 (US) or https://mcp.port.io/v1 (EU)
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_MCP_URL=https://mcp.us.port.io/v1

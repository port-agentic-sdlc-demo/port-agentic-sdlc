# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Port REST (US)
PORT_BASE_URL=https://api.us.getport.io
PORT_API_TOKEN=
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=

# Public URL of this runner (ngrok). Also store as Port secret FACTORY_WEBHOOK_URL
FACTORY_PUBLIC_URL=https://YOUR-TUNNEL.ngrok-free.dev

# GitHub (Developer/Reviewer). PAT needs contents:write and pull_requests:write
GITHUB_TOKEN=
GITHUB_REPO=port-agentic-sdlc-demo/port-agentic-sdlc

# Set to 1 to write files locally instead of opening a real PR
FACTORY_DRY_RUN=0
